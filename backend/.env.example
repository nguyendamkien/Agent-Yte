# Lấy API key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini sử dụng (mặc định gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Embedding (OpenAI) và vector database
# Lấy API key tại https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DB_PATH=app/storage/chroma
VECTOR_COLLECTION=medical_documents
RAG_TOP_K=5
RAG_MIN_SCORE=0.25

# Retrieval: hybrid = BM25 + dense gộp bằng RRF; dense = chỉ tìm theo vector
RETRIEVAL_MODE=hybrid
RAG_CANDIDATES=20
RRF_K=60

# Rerank bằng cross-encoder bge-reranker-v2-m3 (chạy bằng ONNX Runtime; lần đầu tải
# ~571 MB). Trên CPU chậm: ~11.5 s/câu với 10 ứng viên, ~24 s/câu với 20 — xem docs/RAG.md.
RERANK_ENABLED=false
RERANK_ONNX_REPO=onnx-community/bge-reranker-v2-m3-ONNX
RERANK_ONNX_FILE=onnx/model_int8.onnx
RERANK_CANDIDATES=20
RERANK_MIN_SCORE=0.4

DATA_PATH=../data-collection/data/benh_pho_bien_10.jsonl

# Danh sách origin frontend được phép gọi API (cách nhau bởi dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
